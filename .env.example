# Postgres (persistent volume: homework-review_postgres_data)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Host ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# App URL used after OAuth login
APP_URL=http://localhost:3000

# Sessions
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Yandex OAuth (https://oauth.yandex.ru/)
# Redirect URI must be registered in the Yandex app console:
#   http://localhost:3000/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback
