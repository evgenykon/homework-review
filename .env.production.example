# Production env for the server. Managed by CI from GitHub Variables/Secrets.

DOMAIN=home-work-review.duckdns.org

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Images built by GitHub Actions and pushed to GHCR
BACKEND_IMAGE=ghcr.io/evgenykon/homework-review-backend:latest
FRONTEND_IMAGE=ghcr.io/evgenykon/homework-review-frontend:latest

BACKEND_PORT=3001
FRONTEND_PORT=3000

APP_URL=https://home-work-review.duckdns.org
PUBLIC_BACKEND_ORIGIN=https://home-work-review.duckdns.org
PUBLIC_WS_BASE=wss://home-work-review.duckdns.org

SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7
COOKIE_SECURE=true

# Yandex OAuth. Redirect URI must be registered in the Yandex app console.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://home-work-review.duckdns.org/api/auth/yandex/callback
