{$DOMAIN} {
	encode zstd gzip

	# Загруженные изображения отдаются напрямую с диска, минуя Node.
	# Имена файлов — UUID, содержимое не меняется.
	handle_path /media/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle /ws {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}
