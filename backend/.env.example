PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://app:app@postgres:5432/app

# Frontend URL to redirect to after login
APP_URL=http://localhost:3000

# Sessions
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7
COOKIE_SECURE=false

# Yandex OAuth (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback
