generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  parent
  child
}

model Message {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

model User {
  id        String   @id @default(cuid())
  name      String
  photoUrl  String?  @map("photo_url")
  age       Int?
  type      UserType
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   User?  @relation("UserChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children User[] @relation("UserChildren")

  accounts OAuthAccount[]
  sessions Session[]

  invites     Invite[] @relation("InviteParent")
  usedInvites Invite[] @relation("InviteUsedBy")

  @@index([parentId])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique
  parentId  String    @map("parent_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  usedById  String?   @map("used_by_id")
  createdAt DateTime  @default(now()) @map("created_at")

  parent User  @relation("InviteParent", fields: [parentId], references: [id], onDelete: Cascade)
  usedBy User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@map("invites")
}
