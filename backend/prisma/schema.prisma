generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  parent
  child
}

enum ReviewStatus {
  PENDING
  REVIEWED
  APPROVED
}

enum GameAttemptStatus {
  ACTIVE
  SUBMITTED
  CHECKED
}

model Message {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  senderId  String   @map("sender_id")
  body      String
  system    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model ChatSession {
  id         String       @id @default(cuid())
  name       String
  status     ReviewStatus @default(PENDING)
  approvedAt DateTime?    @map("approved_at")
  archivedAt DateTime?    @map("archived_at")
  childId    String       @map("child_id")
  parentId   String       @map("parent_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  child    User       @relation("SessionChild", fields: [childId], references: [id], onDelete: Cascade)
  parent   User       @relation("SessionParent", fields: [parentId], references: [id], onDelete: Cascade)
  messages Message[]
  pages    RoomPage[]
  reads    SessionRead[]
  books    SessionBook[]
  games    Game[]

  @@index([childId])
  @@index([parentId])
  @@map("chat_sessions")
}

model Game {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session  ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  words    GameWord[]
  attempts GameAttempt[]

  @@index([sessionId])
  @@map("games")
}

model GameWord {
  id       String @id @default(cuid())
  gameId   String @map("game_id")
  word     String
  answer   String
  position Int    @default(0)

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers GameAnswer[]

  @@index([gameId])
  @@map("game_words")
}

model GameAttempt {
  id        String            @id @default(cuid())
  gameId    String            @map("game_id")
  taskType  Int               @map("task_type")
  status    GameAttemptStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers GameAnswer[]

  @@index([gameId])
  @@map("game_attempts")
}

model GameAnswer {
  id        String @id @default(cuid())
  attemptId String @map("attempt_id")
  wordId    String @map("word_id")
  value     String
  correct   Boolean @default(false)

  attempt GameAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  word    GameWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([attemptId, wordId])
  @@index([attemptId])
  @@map("game_answers")
}

model SessionRead {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  sessionId         String   @map("session_id")
  lastReadMessageId Int      @default(0) @map("last_read_message_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@map("session_reads")
}

model Book {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  title     String
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  owner User @relation("BookOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  sessions SessionBook[]

  @@index([ownerId])
  @@map("books")
}

model SessionBook {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  bookId    String   @map("book_id")
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([sessionId, bookId])
  @@index([sessionId])
  @@map("session_books")
}

model RoomPage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  position  Int      @default(0)
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  strokes Stroke[]

  @@index([sessionId])
  @@map("room_pages")
}

model Stroke {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  page RoomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("strokes")
}

model User {
  id        String   @id @default(cuid())
  name      String
  photoUrl  String?  @map("photo_url")
  age       Int?
  type      UserType
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   User?  @relation("UserChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children User[] @relation("UserChildren")

  accounts OAuthAccount[]
  sessions Session[]

  invites     Invite[] @relation("InviteParent")
  usedInvites Invite[] @relation("InviteUsedBy")

  childSessions  ChatSession[] @relation("SessionChild")
  parentSessions ChatSession[] @relation("SessionParent")
  messages       Message[]     @relation("MessageSender")
  sessionReads   SessionRead[]
  books          Book[]        @relation("BookOwner")

  @@index([parentId])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique
  parentId  String    @map("parent_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  usedById  String?   @map("used_by_id")
  createdAt DateTime  @default(now()) @map("created_at")

  parent User  @relation("InviteParent", fields: [parentId], references: [id], onDelete: Cascade)
  usedBy User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@map("invites")
}
